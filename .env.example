# Get a free key at https://build.nvidia.com (click a model -> "Get API Key")
NVIDIA_API_KEY=nvapi-your-key-here

# Hosted NVIDIA endpoint (default). For self-hosted NIM on Nebius: http://<server-ip>:8000/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Check build.nvidia.com for current Nemotron model IDs.
# Fallbacks: nvidia/llama-3.3-nemotron-super-49b-v1.5  or  nvidia/nemotron-3-nano-30b-a3b (faster)
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
