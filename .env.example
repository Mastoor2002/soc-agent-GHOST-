# GHOST talks to Nemotron through an OpenAI-compatible API. Pick ONE provider.

# --- Option A: NVIDIA build.nvidia.com (free tier) ---
# Get a key at https://build.nvidia.com (click a model -> "Get API Key")
NVIDIA_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Option B: Nebius Token Factory ---
# Get a key at https://tokenfactory.nebius.com (API keys). To switch, put a # in front of
# the two Option A lines above (NIM_BASE_URL, NIM_MODEL) and remove the # from these three:
# NEBIUS_API_KEY=your-nebius-key-here
# NIM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NIM_MODEL=nvidia/Nemotron-3_5-Lightning
